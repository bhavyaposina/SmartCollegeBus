<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F3F6FB">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seat Availability"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#173B70"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtBusTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BUS 101"
        android:textColor="#2456A6"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />


    <TextView
        android:id="@+id/txtSeatCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available seats: 32 / 40"
        android:textSize="17sp"
        android:textColor="#173B70"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select an available seat"
        android:textSize="15sp"
        android:textColor="#5C6B80"
        android:layout_marginBottom="12dp" />

    <GridLayout
        android:id="@+id/seatGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Green = Available     Red = Booked"
        android:textColor="#5C6B80"
        android:textSize="14sp" />

</LinearLayout>
